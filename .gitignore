# =============================================================================
# Tantra AI — .gitignore
# =============================================================================

# Secrets — NEVER commit these
#.env
#.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
.tmp/*
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / linters
.ruff_cache/

# Node (if any JS tooling)
node_modules/
.npm/
dist/

# Docker bind-mount data directories — excluded from git (data lives on host)
# These directories hold all persistent service data (Postgres, Redis, Qdrant, n8n, OpenWebUI)
# NEVER delete these directories unless you want to wipe the stack's data.
# To back up: make backup     To restore: copy ./data/ from backup
data/postgres/
data/postgres-init/
data/redis/
data/qdrant/
data/n8n/
data/openwebui/
data/models/
data/uploads/
# Ollama model weights — large binaries, re-pullable via 'make pull-models'
data/ollama/
# tantra-media output (large media files — never commit)
data/media/audio/
data/media/images/
data/media/clips/
data/media/output/
# Postgres actual data lives in pgdata/ subdirectory (gitkeep in parent is committed)
data/postgres/pgdata/

# Ollama model cache
*.gguf
*.ggml
*.bin

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Alembic (keep structure, ignore auto-migrations)
alembic/versions/*.pyc

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# Test artifacts
test-results/
playwright-report/

# Compiled assets
*.css.map
*.js.map
