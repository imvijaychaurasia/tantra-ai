# =============================================================================
# Tantra AI — .env.example
# तंत्र  ·  Copy this file to .env and fill in your values
# =============================================================================
# NEVER commit .env to git  (already in .gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
TIMEZONE=Asia/Kolkata             # Your local timezone
SECRET_KEY=tantradevtestkey   # Change this in production (used for JWT signing, etc.)

# ---------------------------------------------------------------------------
# OLLAMA (Local LLM server)
# ---------------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h             # How long models stay loaded in memory
OLLAMA_NUM_PARALLEL=2             # Parallel requests per model
OLLAMA_MAX_LOADED_MODELS=2        # Max models in VRAM simultaneously

# ---------------------------------------------------------------------------
# LITELLM (Model proxy / gateway)
# ---------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=tantradevtestkey   # Change this — used by all internal services

# ---------------------------------------------------------------------------
# CLOUD MODEL API KEYS (optional — leave blank to use local-only)
# ---------------------------------------------------------------------------
# OpenAI (maps to "frontier" alias when OPENAI_API_KEY is set)
OPENAI_API_KEY=

# Anthropic Claude (maps to "frontier" alias — preferred for reasoning tasks)
ANTHROPIC_API_KEY=

# Groq (ultra-fast inference — maps to "fast" alias)
GROQ_API_KEY=

# Together AI (for open-source cloud inference)
TOGETHER_API_KEY=tgp_v1_JP7v-yqFaJi10DZ926dYmoOlYXVIDylBF1fKrYtwMJo

# ---------------------------------------------------------------------------
# POSTGRESQL (Primary database)
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=tantra
POSTGRES_USER=tantra
POSTGRES_PASSWORD=tantradevtestkey   # Change in production

# Async connection string (used by FastAPI/SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://tantra:tantradevtestkey@localhost:5432/tantra

# Sync connection string (used by Alembic migrations)
DATABASE_SYNC_URL=postgresql://tantra:tantradevtestkey@localhost:5432/tantra

# ---------------------------------------------------------------------------
# REDIS (Message broker + cache)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=tantradevtestkey
REDIS_MAX_MEMORY=2gb

# Celery uses separate DBs within the same Redis instance
CELERY_BROKER_URL=redis://:tantradevtestkey@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:tantradevtestkey@localhost:6379/2

# ---------------------------------------------------------------------------
# QDRANT (Vector database)
# ---------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=localhost

# ---------------------------------------------------------------------------
# TANTRA API
# ---------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0

# JWT / Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# CELERY WORKERS
# ---------------------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# OPEN WEBUI
# ---------------------------------------------------------------------------
WEBUI_PORT=3000
WEBUI_ENABLE_SIGNUP=true          # Set false after first user registration

# ---------------------------------------------------------------------------
# N8N (Workflow automation)
# ---------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_USER=admin
N8N_PASSWORD=tantradevtestkey     # Change this

# ---------------------------------------------------------------------------
# MEM0 (Long-term agent memory)
# ---------------------------------------------------------------------------
MEM0_PROVIDER=qdrant              # qdrant | redis | postgresql
MEM0_COLLECTION=tantra_memory

# ---------------------------------------------------------------------------
# AUTH — Google OAuth (for Sign in with Google)
# Get from: https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AUTH — GitHub OAuth (for Sign in with GitHub)
# Get from: https://github.com/settings/applications/new
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (for password reset + email verification)
# Leave blank to disable email features during development
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tantra.ai
SMTP_TLS=true
ENABLE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# WEB TERMINAL (ttyd)
# ---------------------------------------------------------------------------
TTYD_PORT=7681
TTYD_USER=admin
TTYD_PASSWORD=tantradevtestkey   # Change this — used to access the web terminal at /terminal

# ---------------------------------------------------------------------------
# FLOWER (Celery monitoring)
# ---------------------------------------------------------------------------
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=tantradevtestkey   # Change this — used to access Flower dashboard at /flower

# ---------------------------------------------------------------------------
# ZERNIO — Unified Social Media API (PRIMARY — replaces all per-platform OAuth)
# ---------------------------------------------------------------------------
# Zernio lets you connect LinkedIn, X/Twitter, Instagram, TikTok, YouTube and
# 10+ more platforms with a single API key — no individual developer apps needed.
#
# Setup (5 minutes):
#   1. Sign up free at https://zernio.com
#   2. Dashboard → Accounts → "Connect Account" → choose LinkedIn → OAuth in 1 click
#      (also connect YouTube, Twitter, Instagram if you want)
#   3. Dashboard → API Keys → copy your key below
#   4. Restart tantra-api: docker compose restart tantra-api
#   5. Get account IDs: curl http://localhost:8000/api/v1/social/zernio/accounts
#   6. Paste account IDs below and restart again
#
# Your Zernio API key (from https://zernio.com/dashboard/api-keys)
ZERNIO_API_KEY=sk_b1e1a6fdf1fea86a2d39813d1a803ade212a6d61e1d95655870c4cacc1c416d1
# Account IDs — run: curl http://localhost:8000/api/v1/social/zernio/accounts to get them
ZERNIO_LINKEDIN_ACCOUNT_ID=69c770906cb7b8cf4ca7c1c9
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_TWITTER_ACCOUNT_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_DEFAULT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# SOCIAL MEDIA — LINKEDIN DIRECT API (FALLBACK — only if Zernio not configured)
# ---------------------------------------------------------------------------
# Only needed if you prefer direct LinkedIn API access over Zernio.
# Requires registering a LinkedIn Developer App at https://developer.linkedin.com/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social

# ---------------------------------------------------------------------------
# SOCIAL MEDIA — YOUTUBE / GOOGLE
# ---------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=                  # Simple API access (read-only)
YOUTUBE_CLIENT_ID=                # OAuth 2.0 (for uploads & channel management)
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback

# ---------------------------------------------------------------------------
# EMBEDDING MODEL
# ---------------------------------------------------------------------------
EMBED_MODEL=nomic-embed-text      # Ollama embedding model
EMBED_DIM=768
EMBED_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# RAG SETTINGS
# ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# AGENT SETTINGS
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_MEMORY_WINDOW=20            # Last N messages in short-term context
CREW_VERBOSE=true

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | text
