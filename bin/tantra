#!/usr/bin/env bash
# =============================================================================
# Tantra AI — host CLI wrapper
# तंत्र · Delegates to tantra CLI inside the running Docker container
#         where all Python deps (typer, rich, litellm, crewai…) are installed.
#
# One-time setup:
#   chmod +x bin/tantra
#   sudo ln -sf "$(pwd)/bin/tantra" /usr/local/bin/tantra
#
# Then from anywhere:
#   tantra skills list
#   tantra skills info humanizer
#   tantra plugins list
#   tantra status
# =============================================================================
set -euo pipefail

CONTAINER="tantra-api"

# Check the container is running ─────────────────────────────────────────────
if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER}$"; then
    echo "tantra: container '${CONTAINER}' is not running." >&2
    echo "Start it with:  docker compose up -d tantra-api" >&2
    exit 1
fi

# Delegate to tantra inside the container ────────────────────────────────────
# The container has /venv/bin/tantra (installed via pip install .) and
# skills/ is bind-mounted at /app/skills/.
# Use -i but not -t when stdout is not a terminal (pipes, scripts, etc.)
if [ -t 1 ]; then
    exec docker exec -it "${CONTAINER}" tantra "$@"
else
    exec docker exec -i  "${CONTAINER}" tantra "$@"
fi
